#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check if any staged files are in the src/client folder
STAGED_CLIENT_FILES=$(git diff --cached --name-only | grep "^src/client/" | head -1)

if [ -z "$STAGED_CLIENT_FILES" ]; then
  echo "No src/client changes staged — skipping client pre-commit checks."
  exit 0
fi

echo "src/client changes detected — running pre-commit checks..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLIENT_DIR="$REPO_ROOT/src/client"

echo "Running typecheck..."
(cd "$CLIENT_DIR" && npx tsc -p tsconfig.app.json --noEmit) || { echo "Typecheck failed"; exit 1; }

echo "Running lint-staged (ESLint + Prettier)..."
(cd "$CLIENT_DIR" && npx lint-staged) || { echo "lint-staged failed"; exit 1; }

echo "All checks passed."
