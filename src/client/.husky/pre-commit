#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Only run when src/client files are staged
STAGED_CLIENT_FILES=$(git diff --cached --name-only | grep "^src/client/" | head -1)

if [ -z "$STAGED_CLIENT_FILES" ]; then
  echo "No src/client changes staged — skipping client pre-commit checks."
  exit 0
fi

echo "src/client changes detected — running pre-commit checks..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLIENT_DIR="$REPO_ROOT/src/client"

# 1. Prettier — auto-formats staged files and re-stages them (safe, never reverts)
echo "\n[1/3] Formatting staged files with Prettier..."
(cd "$CLIENT_DIR" && npx lint-staged) || { echo "Prettier formatting failed"; exit 1; }

# 2. Typecheck — compile-time errors only, never touches working tree
echo "\n[2/3] Running TypeScript typecheck..."
(cd "$CLIENT_DIR" && npx tsc -p tsconfig.app.json --noEmit) || {
  echo ""
  echo "Typecheck failed. Fix the type errors above and try again."
  echo "Your staged changes have NOT been modified."
  exit 1
}

# 3. ESLint — run directly on staged TS/HTML files (no stash, no revert)
echo "\n[3/3] Running ESLint..."
STAGED_TS_HTML=$(git diff --cached --name-only | grep "^src/client/src/.*\.\(ts\|html\)$" | sed "s|^src/client/||")
if [ -n "$STAGED_TS_HTML" ]; then
  (cd "$CLIENT_DIR" && echo "$STAGED_TS_HTML" | xargs npx eslint) || {
    echo ""
    echo "ESLint found errors. Fix the issues above and try again."
    echo "Your staged changes have NOT been modified."
    exit 1
  }
fi

echo "\nAll checks passed."
